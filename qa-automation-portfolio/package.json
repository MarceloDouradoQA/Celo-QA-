{
  "name": "qa-automation-portfolio",
  "private": true,
  "scripts": {
    "lab": "node lab/server.mjs",
    "test:playwright": "playwright test -c projects/playwright/playwright.config.mjs",
    "test:cypress": "start-server-and-test lab:cypress http://127.0.0.1:3102 \"cypress run --project projects/cypress\"",
    "test:postman": "start-server-and-test lab http://127.0.0.1:3000 \"newman run projects/postman/checkout.postman_collection.json -r cli,junit --reporter-junit-export artifacts/newman.xml\"",
    "test:sql": "python3 -m unittest discover -s projects/sql-data",
    "lab:cypress": "node lab/server.mjs --cypress"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "cypress": "^15.0.0",
    "newman": "6.2.3",
    "start-server-and-test": "^2.1.0"
  }
}
